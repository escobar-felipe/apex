# Staging
ENVIRONMENT=staging
BASE_URL=/
ROOT_DOMAIN=staging.dominio.com
DEFAULT_TENANT_SLUG=default
SECRET_SESSION=staging-long-random-secret-change-before-deploy
CREDENTIALS_SECRET_KEY=replace-with-a-long-random-credentials-secret
SESSION_COOKIE_SECURE=true
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

REDIS_HOST=redis://redis:6379
DATABASE_URL=postgresql://usuario:senha@host-externo:5432/apex_staging
LIMIT=1500
CELERY_RESULT_EXPIRES_SECONDS=604800
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=600
CELERY_TASK_TIME_LIMIT_SECONDS=660
EXTERNAL_REQUEST_TIMEOUT_SECONDS=30
OPENAI_TIMEOUT_SECONDS=60
SMTP_TIMEOUT_SECONDS=30
SEARCH_RESULTS_PER_SOURCE=10
