# Development
COMPOSE_PROFILES=local-db
ENVIRONMENT=development
BASE_URL=/
ROOT_DOMAIN=
DEFAULT_TENANT_SLUG=default
SECRET_SESSION=dev-secret-session-change-me
CREDENTIALS_SECRET_KEY=dev-credentials-secret-change-me
SESSION_COOKIE_SECURE=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

REDIS_HOST=redis://redis:6379
POSTGRES_DB=apex_development
POSTGRES_USER=apex
POSTGRES_PASSWORD=apex_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://apex:apex_dev_password@postgres:5432/apex_development
LIMIT=1500
CELERY_RESULT_EXPIRES_SECONDS=604800
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=600
CELERY_TASK_TIME_LIMIT_SECONDS=660
EXTERNAL_REQUEST_TIMEOUT_SECONDS=30
OPENAI_TIMEOUT_SECONDS=60
SMTP_TIMEOUT_SECONDS=30
SEARCH_RESULTS_PER_SOURCE=10
